# Copiar a .env. El puerto 55432 evita chocar con un Postgres local.
DATABASE_URL=postgres://moneypilot:moneypilot@localhost:55432/moneypilot

# Rol de aplicación: NO es superusuario, para que Row Level Security aplique de verdad.
# (Postgres ignora las policies de RLS para superusuarios y para el dueño de la tabla
# salvo que se fuerce con ALTER TABLE ... FORCE ROW LEVEL SECURITY.)
DATABASE_APP_URL=postgres://moneypilot_app:moneypilot_app@localhost:55432/moneypilot

# ── finAPI (sandbox) ─────────────────────────────────────────────────────────
# Segunda fuente de entrada, además de los ficheros. Sin estas cuatro variables
# la aplicación funciona igual y los tests de `apps/web/lib/finapi` se saltan
# solos, como los que necesitan Postgres.
#
# Los valores NO se versionan: se piden en el portal de finAPI y se ponen en el
# `.env` local o en las variables del proyecto en Vercel. Ninguna lleva prefijo
# NEXT_PUBLIC_ a propósito — el secreto no puede acabar en el bundle del
# navegador.
FINAPI_BASE=https://sandbox.finapi.io
FINAPI_CLIENT_ID=
FINAPI_CLIENT_SECRET=
FINAPI_WEBFORM_BASE=https://webform-sandbox.finapi.io

# Sólo para el test del corpus completo: el usuario de finAPI que ya completó
# el formulario web (finAPI devuelve id y contraseña al crearlo). Sin esto ese
# bloque se salta.
FINAPI_SANDBOX_USER=
FINAPI_SANDBOX_PASSWORD=
