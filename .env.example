# Copiar a .env. El puerto 55432 evita chocar con un Postgres local.
DATABASE_URL=postgres://moneypilot:moneypilot@localhost:55432/moneypilot

# Rol de aplicación: NO es superusuario, para que Row Level Security aplique de verdad.
# (Postgres ignora las policies de RLS para superusuarios y para el dueño de la tabla
# salvo que se fuerce con ALTER TABLE ... FORCE ROW LEVEL SECURITY.)
DATABASE_APP_URL=postgres://moneypilot_app:moneypilot_app@localhost:55432/moneypilot
